# Elitza Agent Configuration
# Copy this to ~/.elitza/config.yaml and customize

# Model to use (OpenRouter model ID)
# Examples:
#   anthropic/claude-sonnet-4
#   anthropic/claude-opus-4
#   openai/gpt-4o
#   google/gemini-2.5-pro
#   deepseek/deepseek-chat
model: ""

# Maximum tool-calling iterations per turn
max_iterations: 50

# Custom system prompt (optional)
# system_prompt: "You are a specialized coding assistant."

# OpenRouter API key is read from:
#   1. OPENROUTER_API_KEY environment variable
#   2. ~/.elitza/.env file
